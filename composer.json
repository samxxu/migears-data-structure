{
    "name": "migears/data-structure",
    "description": "Redis data structure service: explicit Hash/List/Set/ZSet semantics with an interface for redis-compatible servers",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "require": {
        "php": "^8.1",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "suggest": {
        "ext-redis": "Required to use RedisDataStructure implementation"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\DataStructure\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\DataStructure\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    }
}
